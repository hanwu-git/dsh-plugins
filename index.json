    {
      "name": "@local/unified-model-center",
      "title": {
        "en": "Unified Model Center",
        "zh": "统一模型中心"
      },
      "description": {
        "en": "One wide popup for all connected platforms: horizontal provider tabs, frequency-pinned favorites, cross-provider search, and one-click session model switching. Independent of connector plugins, so connector upgrades cannot change its UI.",
        "zh": "一个宽弹窗集中所有已连接平台的模型：横排标签切换、按使用频率置顶常用、跨连接搜索、点击即切换会话模型。独立于各连接器插件，连接器升级不影响界面。"
      },
      "icon": "icons/unified-model-center.svg",
      "author": "hanwu-git",
      "repository": {
        "url": "https://github.com/hanwu-git/dsh-plugins",
        "directory": "packages/unified-model-center"
