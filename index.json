    {
      "name": "@local/composer-buttons",
      "title": {
        "en": "Composer buttons",
        "zh": "输入框按钮组"
      },
      "description": {
        "en": "One row of configurable composer buttons: prompt polish, page refresh, and app restart, each with an on/off switch and an editable note in the plugin settings.",
        "zh": "输入框下方一行可配置按钮：润色提示词、刷新页面、重启应用；插件设置里可逐个开关并编辑说明。"
