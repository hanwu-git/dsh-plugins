{
  "name": "@local/composer-buttons",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One row of configurable composer buttons — prompt polish, page refresh, app restart — each with a description and an on/off switch in the plugin settings.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0"
  }
}
