{
  "name": "@local/credit-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Left-bottom credit balance HUD: one entry in the sidebar footer that opens a floating panel listing the current credit balance of every connected platform.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
